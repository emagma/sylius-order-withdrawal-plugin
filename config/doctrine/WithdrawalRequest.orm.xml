<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine.apache.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine.apache.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <mapped-superclass name="Emagma\SyliusOrderWithdrawalPlugin\Entity\WithdrawalRequest"
                       table="emagma_order_withdrawal_request">
        <indexes>
            <index name="IDX_emagma_withdrawal_state_submitted_at" columns="state,submitted_at"/>
        </indexes>
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>
        <field name="firstName" type="string" column="first_name"/>
        <field name="lastName" type="string" column="last_name"/>
        <field name="orderNumber" type="string" column="order_number"/>
        <field name="orderDate" type="date_immutable" column="order_date"/>
        <field name="notYetReceived" type="boolean" column="not_yet_received"/>
        <field name="receptionDate" type="date_immutable" column="reception_date" nullable="true"/>
        <field name="email" type="string"/>
        <field name="scope" type="string" enum-type="Emagma\SyliusOrderWithdrawalPlugin\Model\WithdrawalScope"/>
        <field name="message" type="text" nullable="true"/>
        <field name="legalNoticeAccepted" type="boolean" column="legal_notice_accepted"/>
        <field name="state" type="string" enum-type="Emagma\SyliusOrderWithdrawalPlugin\Model\WithdrawalRequestState"/>
        <field name="submittedAt" type="datetime_immutable" column="submitted_at"/>
        <field name="updatedAt" type="datetime_immutable" column="updated_at" nullable="true"/>

        <field name="localeCode" type="string" column="locale_code" nullable="true"/>

        <many-to-one field="channel" target-entity="Sylius\Component\Channel\Model\ChannelInterface">
            <join-column name="channel_id" referenced-column-name="id" nullable="true" on-delete="SET NULL"/>
        </many-to-one>
    </mapped-superclass>

</doctrine-mapping>
