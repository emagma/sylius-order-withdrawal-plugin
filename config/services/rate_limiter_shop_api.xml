<?xml version="1.0" encoding="UTF-8"?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <!-- Loaded only when api.shop is on, which requires rate_limiter_service. -->
        <service id="emagma_sylius_order_withdrawal.rate_limit_listener.shop_api"
                 class="Emagma\SyliusOrderWithdrawalPlugin\EventListener\WithdrawalRequestRateLimitListener">
            <argument type="service" id="emagma_sylius_order_withdrawal.rate_limiter.withdrawal_request" />
            <argument>api_withdrawal_requests_shop_post_collection</argument>
            <tag name="kernel.event_listener" event="kernel.request" priority="8" />
        </service>
    </services>

</container>
