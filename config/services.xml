<?xml version="1.0" encoding="UTF-8"?>

<!--
    Deprecated, will be removed in 3.0: kept only so a reference to this path still resolves.
    The plugin's extension loads services.php itself, so do not import this file (doing so has
    always failed with "already been autoconfigured"). Symfony 8 cannot load XML services at all.
-->
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">

    <imports>
        <import resource="services.php" />
    </imports>

</container>
