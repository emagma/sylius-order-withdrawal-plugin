# Build context trimming for the demo image (docker/demo/Dockerfile),
# whose build context is the repository root.
.git
.idea
.claude
.playwright-mcp
# Local-only tooling, never needed in the image.
.docker
docs
var/cache
var/log
var/sessions
# Resolved fresh inside the image (per Symfony line), so keep the host copy out.
vendor
composer.lock
# JS deps are installed/built inside the image.
node_modules
**/node_modules
*.sqlite
.phpunit.result.cache
